{
  "name": "@tanchu/eslint-config",
  "version": "0.2.0",
  "description": "Общий ESLint-конфиг проектов tanchu: Next.js + React + TypeScript + Tailwind CSS v4, доступность (WCAG 2.2 AA), совместимость с browserslist.",
  "type": "module",
  "exports": {
    ".": "./index.js"
  },
  "files": [
    "index.js",
    "rules/*.js",
    "README.md"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tanchu/dev-standards.git",
    "directory": "packages/eslint-config"
  },
  "keywords": [
    "eslint",
    "eslintconfig",
    "nextjs",
    "react",
    "tailwindcss",
    "typescript"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "@eslint-react/eslint-plugin": "^5.30.2",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.6",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-better-tailwindcss": "^4.11.0",
    "eslint-plugin-boundaries": "^7.4.1",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-no-relative-import-paths": "^1.7.3",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  },
  "peerDependencies": {
    "eslint": "^10.14.0",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
